FROM golang:1.25-alpine AS build

WORKDIR /src
RUN apk add --no-cache patch
COPY nethernet-bridge/go.mod nethernet-bridge/go.sum ./
RUN go mod download
COPY nethernet-bridge/patches /patches
RUN module_dir="$(go env GOMODCACHE)/github.com/sandertv/gophertunnel@v1.61.0" && \
    chmod -R u+w "$module_dir" && \
    patch -d "$module_dir" -p1 < /patches/gophertunnel-offline-empty-display-name.patch
COPY nethernet-bridge/*.go ./
RUN go test ./...
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/nethernet-bridge .

FROM alpine:3.22
RUN addgroup -g 65532 proxy && adduser -D -H -u 65532 -G proxy proxy
COPY --from=build /out/nethernet-bridge /usr/local/bin/nethernet-bridge

USER 65532:65532

EXPOSE 7551/udp 50000/udp

ENTRYPOINT ["/usr/local/bin/nethernet-bridge"]
