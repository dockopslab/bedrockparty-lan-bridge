# Copy this file to .env and replace both example IP addresses.
LISTEN_PORT=19132
BACKEND_IP=192.168.1.10
BACKEND_PORT=19132

MOTD=BedrockParty
SUB_MOTD=BedrockParty
PROTOCOL=1001
VERSION=1.26.32
PLAYERS=0
MAX_PLAYERS=10
GAMEMODE=Survival
GAMEMODE_NUM=1
IPV6_PORT=19133
EXTRA_FIELDS=0;1;0

# Replace this sample uint64 with a unique, stable value. Use the same value below.
SERVER_GUID=1234567890123456789
SESSION_TIMEOUT=60
LOG_DISCOVERY=false

NETHERNET_PORT=7551
NETHERNET_SERVER_ID=1234567890123456789
NETHERNET_SERVER_NAME=BedrockParty
NETHERNET_LEVEL_NAME=BedrockParty
NETHERNET_GAME_TYPE=0
# Windows/Docker Desktop: host LAN IPv4. Linux/host network: leave empty.
NETHERNET_PUBLIC_IP=192.168.1.20
NETHERNET_ICE_PORT=50000
LOG_LEVEL=INFO
